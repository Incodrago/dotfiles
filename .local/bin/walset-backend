#!/bin/bash

export PATH=$PATH:/home/Thibaud/.local/bin

# Helper function
hex_to_rgba() {
    local hex=${1#"#"}
    printf "rgba(%d,%d,%d,%s)" "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}" "$2"
}

# Paths
LAST_WALLPAPER_FILE="$HOME/.cache/last_wallpaper.txt"
WAL_JSON="$HOME/.cache/wal/colors.json"
SWAYNC_COLORS="$HOME/.config/swaync/colors.css"
GTK_COLORS="$HOME/.config/gtk-3.0/colors.css"
HYPR_COLORS="$HOME/.config/hypr/pywal-colors.conf"
HYPRLOCK_CONF="$HOME/.config/hypr/hyprlock.conf"

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <path_to_image>"
    exit 1
fi

IMAGE="$1"

# Handle GIF extraction (NOT backgrounded - we need IMAGE_STATIC immediately)
if [[ $(file -b --mime-type "$IMAGE") == "image/gif" ]]; then
    STATIC_IMAGE="$HOME/.cache/static_wallpaper.png"
    magick "$IMAGE[0]" "$STATIC_IMAGE"
    IMAGE_STATIC="$STATIC_IMAGE"
else
    IMAGE_STATIC="$(realpath "$IMAGE")"
fi

# ══════════════════════════════════════════════════════════════════════════════
# IMMEDIATE: Set wallpaper first with random origin (feels faster to user)
# ══════════════════════════════════════════════════════════════════════════════

# Get combined screen dimensions (sum widths, max height) for multi-monitor setup THIS IS MADE FOR TWO 1920x1080 SCREENS
read -r SCREEN_WIDTH SCREEN_HEIGHT <<< "$(hyprctl monitors -j | jq -r '([.[].width] | add | tostring) + " " + ([.[].height] | max | tostring)')"

# Random position for the grow animation
RAND_X=$((RANDOM % SCREEN_WIDTH))
RAND_Y=$((RANDOM % SCREEN_HEIGHT))

# Set wallpaper immediately — user sees change right away
swww img "$IMAGE" \
    --transition-type="grow" \
    --transition-pos="$RAND_X,$RAND_Y" \
    --transition-duration="0.8" \
    --transition-fps="60" &
SWWW_PID=$!

# ══════════════════════════════════════════════════════════════════════════════
# BACKGROUND: Heavy processing happens while wallpaper is animating
# ══════════════════════════════════════════════════════════════════════════════

# Generate pywal colors (the slowest operation)
wal -i "$IMAGE_STATIC" -n -t -e -q

# Read all colors in one jq call
read -r BG FG C1 C2 C3 C4 C5 C6 C8 <<< "$(jq -r '[
    .special.background,
    .special.foreground,
    .colors.color1,
    .colors.color2,
    .colors.color3,
    .colors.color4,
    .colors.color5,
    .colors.color6,
    .colors.color8
] | @tsv' "$WAL_JSON")"

ERROR="$C1"
SUCCESS="$C2"
WARNING="$C3"
INFO="$C4"
ACCENT="$C5"
ACCENT2="$C6"
ACCENT3="$C8"

# Pre-compute RGBA values
BG_TRANSPARENT=$(hex_to_rgba "$BG" "0.8")
FG_RGBA=$(hex_to_rgba "$FG" "1.0")
ACCENT_RGBA=$(hex_to_rgba "$SUCCESS" "1.0")
FAIL_RGBA=$(hex_to_rgba "$ERROR" "1.0")

# ══════════════════════════════════════════════════════════════════════════════
# PARALLEL: Write all config files simultaneously
# ══════════════════════════════════════════════════════════════════════════════

# Hyprland colors
(
    cat > "$HYPR_COLORS" <<EOF
# Generated by walset-backend
general {
    col.active_border = rgba(${SUCCESS:1}ee) rgba(${ACCENT:1}ee) 45deg
    col.inactive_border = rgba(${BG:1}aa)
}
EOF
    hyprctl keyword general:col.active_border "rgba(${SUCCESS:1}ee) rgba(${ACCENT:1}ee) 45deg"
    hyprctl keyword general:col.inactive_border "rgba(${BG:1}aa)"
) &

# GTK colors
(
    cat > "$GTK_COLORS" <<EOF
@define-color wal_bg_color $BG;
@define-color wal_fg_color $FG;
@define-color wal_accent_color $SUCCESS;
EOF
) &

# swaync colors
(
    cat > "$SWAYNC_COLORS" <<EOF
@define-color background $BG;
@define-color background_transparent $BG_TRANSPARENT;
@define-color foreground $FG;
@define-color accent $SUCCESS;
@define-color accent2 $ACCENT;
@define-color accent3 $ACCENT2;
@define-color accent4 $ACCENT3;
@define-color border $ERROR;
@define-color urgent $WARNING;
@define-color info $INFO;
EOF
) &

# Hyprlock config update
(
    sed -e "/^background {/,/^}/ s|^\s*path = .*|    path = $IMAGE_STATIC|" \
        -e "/^input-field {/,/^}/ s|^\s*font_color = .*|    font_color = $FG_RGBA|" \
        -e "/^input-field {/,/^}/ s|^\s*outer_color = .*|    outer_color = $ACCENT_RGBA $ACCENT_RGBA 45deg|" \
        -e "/^input-field {/,/^}/ s|^\s*check_color = .*|    check_color = $ACCENT_RGBA $ACCENT_RGBA 120deg|" \
        -e "/^input-field {/,/^}/ s|^\s*fail_color = .*|    fail_color = $FAIL_RGBA $FAIL_RGBA 40deg|" \
        "$HYPRLOCK_CONF" > "$HYPRLOCK_CONF.tmp" && mv "$HYPRLOCK_CONF.tmp" "$HYPRLOCK_CONF"
) &

# Rofi background - THIS IS MADE FOR TWO 1920x1080 SCREENS
(
    OUTPUT="$HOME/.config/rofi/background.png"
    # Rofi window size (same as the CSS)
    ROFI_WIDTH=$(( SCREEN_WIDTH * 40 / 100 ))
    ROFI_HEIGHT=$(( SCREEN_HEIGHT * 50 / 100 ))
    # Imagebox width = half of Rofi window (minus margins/padding)
    IMAGEBOX_WIDTH=$(( (ROFI_WIDTH - 32) / 2 ))
    IMAGEBOX_HEIGHT=$ROFI_HEIGHT
    # Crop left portion of wallpaper to match imagebox size (ImageMagick)
    # Preserves aspect ratio by resizing first to match height, then crop width
    magick "$IMAGE_STATIC" -resize x$IMAGEBOX_HEIGHT -gravity west -crop ${IMAGEBOX_WIDTH}x${IMAGEBOX_HEIGHT}+0+0 +repage "$OUTPUT"
) &

# Zen browser symlink
(
    PROFILE_DIR=$(find ~/.zen -maxdepth 1 -type d -name "*.Default (release)*" 2>/dev/null | head -n 1)
    if [ -n "$PROFILE_DIR" ]; then
        mkdir -p "$PROFILE_DIR/chrome"
        ln -sf "$HOME/.cache/wal/colors.css" "$PROFILE_DIR/chrome/colors.css"
    fi
) &

# Save wallpaper path
echo "$(realpath "$IMAGE")" > "$LAST_WALLPAPER_FILE" &

# Wait for config writes to finish
wait

# ══════════════════════════════════════════════════════════════════════════════
# RELOAD: Refresh apps that need it
# ══════════════════════════════════════════════════════════════════════════════

pkill -x waybar
waybar > /dev/null 2>&1 &

swaync-client --reload-config --reload-css &

wait $SWWW_PID 2>/dev/null
notify-send -t 2000 "Theme Applied" "Wallpaper and colors updated"
